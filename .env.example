# Core service
HOST=127.0.0.1
PORT=8787
LENS_DB_PATH=lens.sqlite

# Optional provider schedules
RSS_POLL_MS=600000
USGS_POLL_MS=300000
WORLDMONITOR_POLL_MS=600000
EONET_POLL_MS=900000
WORLDMONITOR_BASE_URL=https://api.worldmonitor.app
# Leave empty to keep the hosted adapter disabled. Self-hosted RSS remains active.
WORLDMONITOR_API_KEY=

# Optional Kystverket / BarentsWatch 24-hour vessel history
# Credentials stay server-side. Leave these unset to disable the adapter.
BARENTSWATCH_EVENT_ID=
BARENTSWATCH_MMSI=
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
BARENTSWATCH_POLL_MS=900000
